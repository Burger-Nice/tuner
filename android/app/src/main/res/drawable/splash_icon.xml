<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon: 240 dp box (the system shows the middle 160 dp), the wedge centred in it at the launch size. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="240dp" android:height="240dp"><shape><solid android:color="#00000000"/></shape></item>
    <item android:width="108dp" android:height="104dp" android:gravity="center" android:drawable="@drawable/splash_wedge"/>
</layer-list>
