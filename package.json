{
  "name": "tuner",
  "productName": "airglow",
  "version": "0.1.0",
  "description": "A fast, ad-free IPTV player with Xtream Codes and M3U support.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/fetch-mpv.js && node scripts/build-sentry.js",
    "get-mpv": "node scripts/fetch-mpv.js --again",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "electron-updater": "^6.8.11",
    "hls.js": "^1.7.3",
    "koffi": "^2.16.3",
    "mpegts.js": "^1.8.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@sentry/browser": "11.11.0",
    "7zip-bin": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "0.28.2",
    "playwright": "^1.56.1"
  },
  "build": {
    "appId": "app.tuner.player",
    "productName": "airglow",
    "files": [
      "main.js",
      "mpv.js",
      "preload.js",
      "reports.json",
      "app/**/*",
      "!app/tv/sounds/src/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "vendor/mpv",
          "to": "mpv"
        }
      ],
      "icon": "app/desktop/img/mark-256.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "airglow",
      "artifactName": "Tuner-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Burger-Nice",
        "repo": "tuner",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ]
  }
}
